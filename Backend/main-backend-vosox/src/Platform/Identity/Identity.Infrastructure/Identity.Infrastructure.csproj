<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Identity.Domain\Identity.Domain.csproj" />
    <ProjectReference Include="..\..\SharedKernel\SharedKernel.csproj" />
    
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.17">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.17">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\Role.csv" />
    <EmbeddedResource Include="Migrations\Person.csv" />
    <EmbeddedResource Include="Migrations\User.csv" />
    <EmbeddedResource Include="Migrations\UserRoleMapping.csv" />
    <EmbeddedResource Include="Migrations\RoleFeatureMapping.csv" />
    <EmbeddedResource Include="Migrations\Feature.csv" />
    <EmbeddedResource Include="Migrations\Organization.csv"/>
    <EmbeddedResource Include="Migrations\ApiKey.csv"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Migrations\Role.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\Role.csv</Link>
    </Content>

    <Content Include="Migrations\Person.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\Person.csv</Link>
    </Content>

    <Content Include="Migrations\User.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\User.csv</Link>
    </Content>

    <Content Include="Migrations\UserRoleMapping.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\UserRoleMapping.csv</Link>
    </Content>

    <Content Include="Migrations\RoleFeatureMapping.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\RoleFeatureMapping.csv</Link>
    </Content>

    <Content Include="Migrations\Feature.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\Feature.csv</Link>
    </Content>
    <Content Include="Migrations\Organization.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\Organization.csv</Link>
    </Content>
    <Content Include="Migrations\ApiKey.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\ApiKey.csv</Link>
      </Content>
    <Content Include="Migrations\ModelMapping.csv" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Identity.Infrastructure\Migrations\ModelMapping.csv</Link>
      </Content>

  </ItemGroup>

</Project>
