{
  "name": "vosox-front-end",
  "version": "1.0.0",
  "description": "Vosox Microfrontend Monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w packages/host-app\" \"npm run dev -w packages/remote-buyer\" \"npm run dev -w packages/remote-supplier\" \"npm run dev -w packages/remote-platform-user\" \"npm run dev -w packages/remote-mobile\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "axios": "^1.18.1",
    "country-state-city": "^3.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "react-toastify": "^11.1.0"
  }
}
